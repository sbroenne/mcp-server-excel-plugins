{
  "name": "mcp-server-excel-plugins",
  "description": "Windows-only Claude Code plugins for Excel automation with ExcelMcp.",
  "owner": {
    "name": "Stefan Brönner",
    "email": "3026464+sbroenne@users.noreply.github.com"
  },
  "plugins": [
    {
      "name": "excel-mcp",
      "source": "./plugins/excel-mcp",
      "description": "Automate Microsoft Excel from chat with rich MCP tools for workbooks, formulas, Power Query, PivotTables, charts, and more. Requires Windows and desktop Excel.",
      "version": "2.3.9",
      "author": {
        "name": "Stefan Brönner",
        "email": "3026464+sbroenne@users.noreply.github.com",
        "url": "https://github.com/sbroenne"
      },
      "homepage": "https://excelmcpserver.dev/",
      "repository": "https://github.com/sbroenne/mcp-server-excel",
      "license": "MIT",
      "keywords": [
        "excel",
        "windows",
        "mcp",
        "power-query",
        "dax",
        "pivottable",
        "vba",
        "com-interop"
      ],
      "mcpServers": {
        "excel-mcp": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@sbroenne/mcp-server-excel@latest"
          ]
        }
      }
    },
    {
      "name": "excel-cli",
      "source": "./plugins/excel-cli",
      "description": "Automate Microsoft Excel from coding agents and scripts with a token-efficient CLI for workbooks, formulas, Power Query, PivotTables, and more. Requires Windows and desktop Excel.",
      "version": "2.3.9",
      "author": {
        "name": "Stefan Brönner",
        "email": "3026464+sbroenne@users.noreply.github.com",
        "url": "https://github.com/sbroenne"
      },
      "homepage": "https://excelmcpserver.dev/",
      "repository": "https://github.com/sbroenne/mcp-server-excel",
      "license": "MIT",
      "keywords": [
        "excel",
        "windows",
        "cli",
        "automation",
        "scripting",
        "batch",
        "power-query",
        "dax",
        "pivottable",
        "ci-cd"
      ]
    }
  ]
}
